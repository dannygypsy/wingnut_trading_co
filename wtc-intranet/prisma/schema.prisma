generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CashFlow {
  id                   String                 @id @default(uuid()) @db.VarChar(255)
  transaction_date     DateTime               @db.DateTime(0)
  type                 wtc_cash_flow_type
  category             wtc_cash_flow_category
  description          String                 @db.VarChar(512)
  amount               Decimal                @db.Decimal(10, 2)
  payment_method       String?                @db.VarChar(255)
  vendor               String?                @db.VarChar(255)
  receipt_image        Bytes?                 @db.Blob
  notes                String?                @db.Text
  created_by           String                 @db.VarChar(255)
  created_at           DateTime               @default(now()) @db.DateTime(0)
  related_order_id     String?                @db.VarChar(255)
  related_inventory_id String?                @db.VarChar(255)

  @@map("wtc_cash_flow")
}

model Inventory {
  id            String             @id @default(uuid()) @db.VarChar(255)
  product_id    String?            @db.VarChar(36)
  type          wtc_inventory_type
  category      String             @db.VarChar(255)
  name          String             @db.VarChar(255)
  full_name     String             @db.VarChar(255)
  size          String?            @db.VarChar(5)
  cost          Float
  retail        Float
  image         Bytes?             @db.Blob
  purchased_on  DateTime           @db.Date
  num_purchased Int
  remaining     Int

  orderItems OrderItem[]
  orderCustomizations OrderCustomization[]

  @@map("wtc_inventory")
}

model InventoryCategory {
  id         Int                  @id @default(autoincrement())
  name       String?              @db.VarChar(24)
  sort_order Int?
  placements InventoryPlacement[]

  @@map("wtc_inventory_categories")
}

model InventoryPlacement {
  id          Int                @id @default(autoincrement())
  category_id Int?
  name        String?            @db.VarChar(255)
  sort_order  Int?
  category    InventoryCategory? @relation(fields: [category_id], references: [id], onDelete: Cascade, map: "fk_cat_id")

  @@index([category_id], map: "fk_cat_id")
  @@map("wtc_inventory_placements")
}

model Order {
  id               String              @id @default(uuid()) @db.VarChar(255)
  customer         String              @db.VarChar(255)
  salesperson_name String?             @db.VarChar(100)
  notes            String?             @db.VarChar(512)
  created_at       DateTime            @db.DateTime(0)
  created_by       String              @db.VarChar(255)
  total            Float               @default(0)
  status           String              @db.VarChar(255)
  discount_desc    String?             @db.VarChar(255)
  discount_percent Float?
  payment_method   String              @default("not paid") @db.VarChar(255)

  items            OrderItem[]
  customizations   OrderCustomization[]

  @@map("wtc_orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.VarChar(255)
  order_id     String   @db.VarChar(255)
  inventory_id String?  @db.VarChar(255)   // <-- add the ?
  name         String   @db.VarChar(255)
  retail       Float
  quantity     Int
  size         String?  @db.VarChar(10)

  order          Order                @relation(fields: [order_id], references: [id])
  inventory      Inventory?           @relation(fields: [inventory_id], references: [id])
  customizations OrderCustomization[]

  @@map("wtc_order_items")
}

model OrderCustomization {
  id           String  @id @default(uuid()) @db.VarChar(255)
  order_id     String  @db.VarChar(255)
  item_id      String  @db.VarChar(255)
  position     String  @db.VarChar(255)
  inventory_id String  @db.VarChar(255)
  name         String  @db.VarChar(255)
  retail       Float
  notes        String? @db.VarChar(512)

  order Order     @relation(fields: [order_id], references: [id])
  item  OrderItem @relation(fields: [item_id], references: [id])
  inventory Inventory? @relation(fields: [inventory_id], references: [id])

  @@map("wtc_order_customizations")
}

model accounts_old {
  id               Int                      @id @default(autoincrement()) @db.UnsignedInt
  qr_code          String                   @db.VarChar(40)
  name             String                   @db.VarChar(80)
  real_name        String?                  @db.VarChar(128)
  email            String                   @db.VarChar(80)
  verified         Boolean                  @default(false)
  about_me         String?                  @db.LongText
  blurb            String?                  @db.LongText
  old_status       accounts_old_old_status
  is_admin         accounts_old_is_admin    @default(no)
  status           accounts_old_status      @default(ACTIVE)
  show_in_search   Int                      @default(1) @db.TinyInt
  show_calendar    Int                      @default(1) @db.TinyInt
  show_activity    Int                      @default(1) @db.TinyInt
  fetlife          String?                  @db.VarChar(128)
  facebook         String?                  @db.VarChar(256)
  twitter          String?                  @db.VarChar(256)
  google_plus      String?                  @db.VarChar(256)
  login            String?                  @unique(map: "login_index") @db.VarChar(40)
  password         String                   @db.VarChar(80)
  password_secure  String?                  @db.VarChar(255)
  last_login       DateTime?                @db.Timestamp(0)
  old_guest_of     Int?
  old_money        Int                      @default(0)
  old_escape       accounts_old_old_escape  @default(no)
  notes            String?                  @db.LongText
  current_group    Int                      @default(0)
  view_rating      accounts_old_view_rating @default(g)
  timezone         String                   @default("America/New_York") @db.VarChar(48)
  login_token      String?                  @db.VarChar(48)
  reset_token      String?                  @db.VarChar(48)
  reset_token_time DateTime?                @db.Timestamp(0)
  verify_token     String?                  @db.VarChar(48)
  max_images       Int                      @default(25)
  max_groups       Int                      @default(10)
}

model bank__transactions {
  id          Int                     @id @default(autoincrement())
